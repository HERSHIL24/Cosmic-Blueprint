# Django secret key – replace with a strong random string
SECRET_KEY=CHANGE_THIS_TO_A_STRONG_RANDOM_KEY
# PostgreSQL connection (matches docker‑compose.yml)
POSTGRES_DB=cosmicdb
POSTGRES_USER=cosmicuser
POSTGRES_PASSWORD=cosmicpass
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# URL of the Node.js microservice (used by the proxy layer)
NODE_SERVICE_URL=http://node-engine:5000
