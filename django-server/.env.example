# ============================================================
#  .env.example  –  Copy to .env and fill in real values
# ============================================================

# Django
SECRET_KEY=django-insecure-replace-with-a-50-char-random-string
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
DJANGO_LOG_LEVEL=INFO

# PostgreSQL
POSTGRES_NAME=astrology_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Node.js microservice
NODE_SERVICE_URL=http://localhost:5000

# Node proxy timeout (seconds)
NODE_PROXY_TIMEOUT=30

# CORS (comma-separated; only used when DEBUG=False)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080
